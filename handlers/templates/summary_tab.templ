package templates

import (
	"fmt"
	"github.com/GrzegorzMika/budget/domain"
)

templ SummaryTab(total float64, expenses []*domain.Expense) {
	<div class="summary-container">
		<h2 class="section-title">Current Month Summary</h2>
		
		<div class="total-bar">
			<span class="total-label">Total Expenses:</span>
			<span class="total-amount">{ fmt.Sprintf("%.2f", total) }</span>
		</div>

		<div class="table-container">
			<table class="expenses-table">
				<thead>
					<tr>
						<th>Date</th>
						<th>Category</th>
						<th>Amount</th>
					</tr>
				</thead>
				<tbody>
					if len(expenses) == 0 {
						<tr>
							<td colspan="3" class="text-center">No expenses recorded this month.</td>
						</tr>
					} else {
						for _, exp := range expenses {
							<tr>
								<td>{ exp.Timestamp.Format("2006-01-02") }</td>
								<td>{ string(exp.Category) }</td>
								<td>{ fmt.Sprintf("%.2f", exp.Amount) }</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
}
