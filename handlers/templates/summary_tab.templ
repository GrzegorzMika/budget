package templates

import (
	"fmt"
	"github.com/GrzegorzMika/budget/domain"
)

templ SummaryTab(label string, from string, to string, total float64, expenses []*domain.Expense) {
	<div class="summary-container">
		<h2 class="section-title">{ label }</h2>

		<form method="GET" action="/" class="range-form">
			<input type="hidden" name="tab" value="summary"/>
			<div class="range-field">
				<label for="from">From:</label>
				<input type="date" id="from" name="from" value={ from } required/>
			</div>
			<div class="range-field">
				<label for="to">To:</label>
				<input type="date" id="to" name="to" value={ to } required/>
			</div>
			<button class="submit-button">Show</button>
		</form>

		<div class="total-bar">
			<span class="total-label">Total Expenses:</span>
			<span class="total-amount">{ fmt.Sprintf("%.2f", total) }</span>
		</div>

		<div class="table-container">
			<table class="expenses-table">
				<thead>
					<tr>
						<th>Date</th>
						<th>Category</th>
						<th>Amount</th>
					</tr>
				</thead>
				<tbody>
					if len(expenses) == 0 {
						<tr>
							<td colspan="3" class="text-center">No expenses recorded in this period.</td>
						</tr>
					} else {
						for _, exp := range expenses {
							<tr>
								<td>{ exp.Timestamp.Format("2006-01-02") }</td>
								<td>
									{ string(exp.Category) }
									if exp.Description != "" {
										<span class="expense-note">{ exp.Description }</span>
									}
								</td>
								<td>{ fmt.Sprintf("%.2f", exp.Amount) }</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</div>
}
